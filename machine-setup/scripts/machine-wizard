#!/bin/sh
# Bootstrap for machine-wizard: installs zsh if missing, then runs the zsh wizard.
set -e

if ! command -v zsh >/dev/null 2>&1; then
  echo "[machine-wizard] zsh not found; installing..."
  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update -qq && sudo apt-get install -y zsh
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y zsh
  elif command -v yum >/dev/null 2>&1; then
    sudo yum install -y zsh
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --noconfirm zsh
  elif command -v zypper >/dev/null 2>&1; then
    sudo zypper install -y zsh
  elif command -v apk >/dev/null 2>&1; then
    sudo apk add --no-cache zsh
  else
    echo "[machine-wizard] No supported package manager found. Please install zsh and re-run." >&2
    exit 1
  fi
fi

exec zsh "$0.zsh" "$@"
