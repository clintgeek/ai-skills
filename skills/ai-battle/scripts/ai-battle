#!/bin/sh
# Bootstrap wrapper for battle_runner.sh.
# battle_runner.sh needs bash 4+ (ai-tools.sh uses associative arrays) and
# macOS ships bash 3.2 forever, so find a modern bash -- installing one via
# the package manager if needed -- and re-exec under it.
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

. "$REPO_ROOT/lib/bootstrap.sh"

for arg in "$@"; do
  case "$arg" in
    --yes) BS_ASSUME_YES=1; export BS_ASSUME_YES ;;
  esac
done

bs_exec_bash "$SCRIPT_DIR/battle_runner.sh" "$@"
