#!/bin/sh
# Bootstrap wrapper for machine-wizard.
# Guarantees brew (macOS), zsh, and a modern bash exist -- and that zsh is the
# login shell -- then runs the zsh wizard. All of that logic is shared:
# lib/bootstrap.sh, which is POSIX sh precisely so it can run here, before the
# shells it installs are known to exist.
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

. "$REPO_ROOT/lib/bootstrap.sh"

# Mirror the wizard's own consent flags into the bootstrapper so it never
# installs anything the wizard itself would have stopped to ask about.
for arg in "$@"; do
  case "$arg" in
    --yes) BS_ASSUME_YES=1; export BS_ASSUME_YES ;;
    --dry-run) BS_DRY_RUN=1; export BS_DRY_RUN ;;
  esac
done

bs_bootstrap || bs_warn "bootstrap incomplete; the wizard may not be able to install everything"

bs_exec_zsh "$SCRIPT_DIR/machine-wizard.zsh" "$@"
